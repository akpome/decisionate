# Deployment configuration contract. Change provider values here or in the
# hosting provider's secret store; application code should not change when
# moving between providers. See docs/provider-migration.md.
# Local development default. Railway Postgres can use a standard
# postgres:// or postgresql:// URL; the API normalizes it to psycopg.
DATABASE_URL=sqlite:///./decisionate.db
APP_ENV=development
# Staging and production require a managed PostgreSQL URL. Local development
# may use SQLite. On Railway, set DATABASE_URL to a reference such as
# ${{postgres.DATABASE_URL}}; do not paste a database URL into application code.
DATASET_UPLOAD_DIR=uploads
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Object storage. Keep local for development; use r2, s3, gcs, or azure for
# durable deployments. Dataset business logic uses the same adapter for all.
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=auto
# R2_* aliases are accepted for direct Cloudflare configuration.
# R2_BUCKET=
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# During a provider migration, keep the old store available with these
# provider-specific variables. New R2 references use r2://; older R2 uploads
# may use s3:// and are treated as legacy R2 references.
# OBJECT_STORAGE_R2_BUCKET=
# OBJECT_STORAGE_R2_ENDPOINT=
# OBJECT_STORAGE_R2_ACCESS_KEY=
# OBJECT_STORAGE_R2_SECRET_KEY=
# OBJECT_STORAGE_LEGACY_S3_PROVIDER=r2
# S3_BUCKET=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=
# GCS can use a service-account JSON string, a mounted JSON file, or the
# provider's application-default credentials.
# OBJECT_STORAGE_PROJECT=
# OBJECT_STORAGE_CREDENTIALS_FILE=
# OBJECT_STORAGE_CREDENTIALS_JSON=
# GCS_PROJECT=
# GCS_BUCKET=
# GCS_CREDENTIALS_FILE=
# GCS_CREDENTIALS_JSON=
# Azure can use a connection string or account URL plus account key/SAS token.
# OBJECT_STORAGE_CONNECTION_STRING=
# OBJECT_STORAGE_ACCOUNT_URL=
# OBJECT_STORAGE_ACCOUNT_NAME=
# OBJECT_STORAGE_ACCOUNT_KEY=
# OBJECT_STORAGE_SAS_TOKEN=
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=
# AZURE_STORAGE_ACCOUNT_URL=
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_ACCOUNT_KEY=
# AZURE_STORAGE_SAS_TOKEN=

# AI analysis. Set the provider, API key, model, and complete API endpoint in
# deployment configuration. Without a complete configuration, the product
# returns an explicitly labeled rules fallback.
AI_PROVIDER=openai
# Provider-neutral names are preferred. The OPENAI_* names below remain
# supported as compatibility aliases for existing deployments.
AI_API_KEY=
AI_MODEL=
AI_API_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_API_URL=
AI_REQUEST_TIMEOUT_SECONDS=20
# Bound structured responses to control provider cost and latency.
AI_MAX_OUTPUT_TOKENS=500
# Cache successful aggregate analyses briefly to reduce repeat provider calls.
AI_ANALYSIS_CACHE_TTL_SECONDS=300

# Platform email bootstrap/fallback for Decisionate system mail, KPI alerts, and
# reports. Platform admins can override these values from /platform-admin;
# workspace SMTP remains optional for customer alert/report overrides.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Decisionate
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Decisionate
ALERTS_SCHEDULER_SECRET=
CONNECTORS_SCHEDULER_SECRET=
BILLING_SCHEDULER_SECRET=
SCHEDULED_JOBS=connectors,alerts,billing
SCHEDULER_TIMEOUT_SECONDS=60
BILLING_SCHEDULER_TIMEOUT_SECONDS=30
BILLING_GRACE_PERIOD_DAYS=7

# Stripe subscription billing. Leave blank for local/free-mode development.
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
# Stripe API base URL. Keep this in deployment configuration so a compatible
# billing endpoint can be selected without changing application code.
STRIPE_API_URL=https://api.stripe.com/v1
# Monthly and annual Stripe Price IDs. Monthly checkout includes a 30-day
# full-access trial; annual checkout includes a 60-day trial.
STRIPE_PROFESSIONAL_PRICE_ID=
STRIPE_PROFESSIONAL_ANNUAL_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=
STRIPE_AGENCY_ANNUAL_PRICE_ID=
STRIPE_CLIENT_WORKSPACE_ADDON_PRICE_ID=
STRIPE_CLIENT_WORKSPACE_ADDON_ANNUAL_PRICE_ID=
STRIPE_AI_CREDIT_PACK_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
DECISIONATE_WEB_APP_URL=http://localhost:3000
# Use the deployed HTTPS API URL in production.

# Adjustable monthly Decisionate AI credit allocations. These settings are
# read by billing and AI metering at runtime, so pricing policy can change
# without a code release.
DECISIONATE_FREE_AI_CREDITS=1000
DECISIONATE_PROFESSIONAL_AI_CREDITS=5000
DECISIONATE_AGENCY_AI_CREDITS=25000
DECISIONATE_AGENCY_CLIENT_AI_CREDITS=2500
DECISIONATE_ADDITIONAL_CLIENT_WORKSPACE_AI_CREDITS=2500
DECISIONATE_AI_CREDIT_PACK_SIZE=5000

# Used by scripts/send_due_weekly_reports.py when no CLI arguments are given.
DECISIONATE_API_URL=http://localhost:8000
ALERTS_SCHEDULER_TIMEOUT_SECONDS=30

# Analytics engine. DuckDB is the local/default execution engine. Keep
# ANALYTICS_STORAGE_FORMAT=parquet so datasets can migrate cleanly to BigQuery.
ANALYTICS_ENGINE=duckdb
ANALYTICS_STORAGE_FORMAT=parquet
ANALYTICS_STORAGE_DIR=analytics/datasets
DUCKDB_DATABASE_PATH=analytics/decisionate.duckdb

# Distributed cache/rate-limit seam. Memory is correct for local development;
# set CACHE_PROVIDER=redis and REDIS_URL on Railway/Upstash.
CACHE_PROVIDER=memory
REDIS_URL=

# Optional error monitoring. The API initializes Sentry only when a DSN exists.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Google Analytics 4 connector. The normal path uses OAuth so each workspace
# owner authorizes a Google account that has access to the selected GA4 property.
GOOGLE_ANALYTICS_CLIENT_ID=
GOOGLE_ANALYTICS_CLIENT_SECRET=
GOOGLE_ANALYTICS_OAUTH_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_ANALYTICS_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_ANALYTICS_OAUTH_SCOPES=https://www.googleapis.com/auth/analytics.readonly
# Legacy service-account fallback. Keep credentials server-side.
GOOGLE_ANALYTICS_SCOPE=https://www.googleapis.com/auth/analytics.readonly
# GOOGLE_ANALYTICS_SERVICE_ACCOUNT_FILE=
# Or inject the service-account JSON through a managed secret.
# GOOGLE_ANALYTICS_SERVICE_ACCOUNT_JSON=

# Google Ads connector. OAuth authorizes the Google Ads user; the developer
# token is an application-level server secret required by every Google Ads API
# request. The customer account ID is entered on the connection in Decisionate.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_BASE_URL=https://googleads.googleapis.com
GOOGLE_ADS_API_VERSION=v22
GOOGLE_ADS_OAUTH_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_ADS_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_ADS_OAUTH_SCOPES=https://www.googleapis.com/auth/adwords

# Authentication is currently Clerk, but the API identity boundary is
# provider-neutral. AUTH_* names are preferred; CLERK_* aliases remain for
# existing local environments during the migration.
AUTH_PROVIDER=clerk
# AUTH_JWKS_URL=
# AUTH_JWT_AUDIENCE=
# AUTH_JWT_ISSUER=
# Optional. When AUTH_JWKS_URL or CLERK_JWKS_URL is set, protected API routes require bearer tokens.
# CLERK_JWKS_URL=https://example.clerk.accounts.dev/.well-known/jwks.json
# CLERK_JWT_AUDIENCE=
# CLERK_JWT_ISSUER=

# Optional bootstrap for the first platform-admin grant. Once the API starts,
# the grant is persisted against an internal Decisionate user in the database.
DECISIONATE_PLATFORM_ADMIN_USER_IDS=
# Preferred for platform-owner access because it survives authentication-provider
# user-ID changes. Use the verified account email address(es), comma-separated.
DECISIONATE_PLATFORM_ADMIN_EMAILS=

# Connector OAuth apps. Leave providers blank until they are configured.
# Generate a Fernet key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_TOKEN_ENCRYPTION_KEY=
OAUTH_CALLBACK_URL=http://localhost:8000/oauth/callback
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_API_BASE_URL_TEMPLATE=https://{shop_domain}/admin/api/{api_version}
SHOPIFY_OAUTH_AUTHORIZATION_URL_TEMPLATE=https://{shop_domain}/admin/oauth/authorize
SHOPIFY_OAUTH_TOKEN_URL_TEMPLATE=https://{shop_domain}/admin/oauth/access_token
SHOPIFY_OAUTH_SCOPES=read_orders read_products read_customers
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_API_BASE_URL=https://quickbooks.api.intuit.com
QUICKBOOKS_API_VERSION=v3
QUICKBOOKS_OAUTH_AUTHORIZATION_URL=https://appcenter.intuit.com/connect/oauth2
QUICKBOOKS_OAUTH_TOKEN_URL=https://oauth.platform.intuit.com/oauth2/v1/tokens/bearer
QUICKBOOKS_OAUTH_SCOPES=com.intuit.quickbooks.accounting
FRESHBOOKS_CLIENT_ID=
FRESHBOOKS_CLIENT_SECRET=
FRESHBOOKS_API_BASE_URL_TEMPLATE=https://api.freshbooks.com/accounting/account/{account_id}
FRESHBOOKS_IDENTITY_API_URL=https://api.freshbooks.com/auth/api/v1/users/me
FRESHBOOKS_PROJECTS_API_BASE_URL_TEMPLATE=https://api.freshbooks.com/projects/business/{business_id}
FRESHBOOKS_BUSINESS_API_BASE_URL_TEMPLATE=https://api.freshbooks.com/accounting/businesses/{business_uuid}
FRESHBOOKS_OAUTH_AUTHORIZATION_URL=https://auth.freshbooks.com/oauth/authorize/
FRESHBOOKS_OAUTH_TOKEN_URL=https://api.freshbooks.com/auth/oauth/token
FRESHBOOKS_OAUTH_SCOPES=user:profile:read user:invoices:read user:expenses:read user:payments:read user:clients:read user:account:read user:credit_notes:read user:projects:read
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=
# Sage Accounting developer subscription key required by the Accounting API.
SAGE_API_SUBSCRIPTION_KEY=
# Configure the Sage Accounting API deployment and its required business header.
SAGE_API_BASE_URL=https://api.columbus.sage.com/uki/sageone/accounts/v3
SAGE_BUSINESS_HEADER=X-Site
SAGE_OAUTH_AUTHORIZATION_URL=https://www.sageone.com/oauth2/auth/central
SAGE_OAUTH_TOKEN_URL=
SAGE_OAUTH_SCOPES=readonly
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_API_BASE_URL=https://api.hubapi.com
HUBSPOT_CRM_API_VERSION=v3
HUBSPOT_OAUTH_AUTHORIZATION_URL=https://app.hubspot.com/oauth/authorize
HUBSPOT_OAUTH_TOKEN_URL=https://api.hubapi.com/oauth/2026-03/token
HUBSPOT_OAUTH_SCOPES=crm.objects.contacts.read crm.objects.companies.read crm.objects.deals.read tickets
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# Use the Salesforce login or sandbox OAuth authorize/token endpoints for the
# connected app environment being configured.
SALESFORCE_OAUTH_AUTHORIZATION_URL=
SALESFORCE_OAUTH_TOKEN_URL=
SALESFORCE_OAUTH_SCOPES=api refresh_token
# Example format: 65.0. The value is deployment configuration, not a user field.
SALESFORCE_API_VERSION=
META_ADS_APP_ID=
META_ADS_APP_SECRET=
META_ADS_API_BASE_URL=https://graph.facebook.com
META_ADS_GRAPH_VERSION=v23.0
# Meta Insights granularity. Use 1 for one row per day or all for a range total.
META_ADS_TIME_INCREMENT=1
META_ADS_OAUTH_AUTHORIZATION_URL=https://www.facebook.com/v23.0/dialog/oauth
META_ADS_OAUTH_TOKEN_URL=https://graph.facebook.com/v23.0/oauth/access_token
META_ADS_OAUTH_SCOPES=ads_read
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_API_BASE_URL=https://api.xero.com/api.xro/2.0
XERO_CONNECTIONS_API_URL=https://api.xero.com/connections
XERO_OAUTH_AUTHORIZATION_URL=https://login.xero.com/identity/connect/authorize
XERO_OAUTH_TOKEN_URL=https://identity.xero.com/connect/token
XERO_OAUTH_SCOPES=openid profile email offline_access accounting.invoices.read accounting.payments.read accounting.contacts.read accounting.settings.read
ZOHO_BOOKS_CLIENT_ID=
ZOHO_BOOKS_CLIENT_SECRET=
ZOHO_BOOKS_API_BASE_URL=https://www.zohoapis.com/books/v3
ZOHO_BOOKS_OAUTH_AUTHORIZATION_URL=https://accounts.zoho.com/oauth/v2/auth
ZOHO_BOOKS_OAUTH_TOKEN_URL=https://accounts.zoho.com/oauth/v2/token
ZOHO_BOOKS_OAUTH_SCOPES=ZohoBooks.settings.READ ZohoBooks.invoices.READ ZohoBooks.contacts.READ ZohoBooks.expenses.READ ZohoBooks.customerpayments.READ ZohoBooks.creditnotes.READ ZohoBooks.estimates.READ ZohoBooks.salesorders.READ ZohoBooks.projects.READ
# CRM_CLIENT_ID=
# CRM_CLIENT_SECRET=
# MARKETING_PLATFORM_CLIENT_ID=
# MARKETING_PLATFORM_CLIENT_SECRET=
CONNECTORS_SCHEDULER_SECRET=
CONNECTORS_SCHEDULER_TIMEOUT_SECONDS=30

# API-key based connectors.
# STRIPE_WEBHOOK_SECRET=
# CUSTOM_REST_API_BASE_URL=
# CUSTOM_REST_API_KEY=

# Database connector URLs. Prefer provider-specific secret storage in production;
# these local placeholders document the expected connection shapes.
# POSTGRESQL_SOURCE_URL=
# MYSQL_SOURCE_URL=
# SQL_SERVER_SOURCE_URL=
# BIGQUERY_PROJECT_ID=
# BIGQUERY_ANALYTICS_DATASET=
# BIGQUERY_LOCATION=US
# BIGQUERY_CREDENTIALS_JSON=
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_DATABASE=
# SNOWFLAKE_SCHEMA=

# Future generic webhook ingestion.
# DATASET_WEBHOOK_SIGNING_SECRET=
