DATABASE_URL=sqlite:///./decisionate.db
DATASET_UPLOAD_DIR=uploads
CORS_ALLOWED_ORIGINS=http://localhost:3000

# AI analysis. With OPENAI_API_KEY set, alerts and reports use structured
# model output. Without it, the product returns an explicitly labeled rules fallback.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
AI_REQUEST_TIMEOUT_SECONDS=20
# Bound structured responses to control provider cost and latency.
AI_MAX_OUTPUT_TOKENS=500
# Cache successful aggregate analyses briefly to reduce repeat provider calls.
AI_ANALYSIS_CACHE_TTL_SECONDS=300

# Weekly AI-assisted KPI email alerts. Leave blank until SMTP is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Decisionate
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20
ALERTS_SCHEDULER_SECRET=

# Analytics engine. DuckDB is the local/default execution engine. Keep
# ANALYTICS_STORAGE_FORMAT=parquet so datasets can migrate cleanly to BigQuery.
ANALYTICS_ENGINE=duckdb
ANALYTICS_STORAGE_FORMAT=parquet
ANALYTICS_STORAGE_DIR=analytics/datasets
DUCKDB_DATABASE_PATH=analytics/decisionate.duckdb

# Optional. When CLERK_JWKS_URL is set, protected API routes require bearer tokens.
# CLERK_JWKS_URL=https://example.clerk.accounts.dev/.well-known/jwks.json
# CLERK_JWT_AUDIENCE=
# CLERK_JWT_ISSUER=

# Future connector OAuth apps. Leave unset until each connector is implemented.
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# SHOPIFY_WEBHOOK_SECRET=
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_ANALYTICS_CLIENT_ID=
# GOOGLE_ANALYTICS_CLIENT_SECRET=
# ONEDRIVE_CLIENT_ID=
# ONEDRIVE_CLIENT_SECRET=
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# CRM_CLIENT_ID=
# CRM_CLIENT_SECRET=
# MARKETING_PLATFORM_CLIENT_ID=
# MARKETING_PLATFORM_CLIENT_SECRET=

# Future API-key based connectors.
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=
# CUSTOM_REST_API_BASE_URL=
# CUSTOM_REST_API_KEY=

# Future database and warehouse connectors. Prefer provider-specific secret
# storage in production; these local placeholders document expected shapes.
# POSTGRESQL_SOURCE_URL=
