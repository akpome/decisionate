# Local Decisionate API
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Clerk browser authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk server authentication. Use the secret from the same Clerk instance.
CLERK_SECRET_KEY=

# Fallback for bearer auth when the Clerk provider token bridge is unavailable.
# The normal browser flow supplies the Clerk bearer token automatically.
NEXT_PUBLIC_ENABLE_API_BEARER_AUTH=false

# Hosted-portal builds receive these automatically; leave blank for .ca.
# No Stripe, Resend or platform provisioning secrets belong in a frontend.
NEXT_PUBLIC_PORTAL_ID=
NEXT_PUBLIC_PORTAL_NAME=
NEXT_PUBLIC_PORTAL_LOGO=
NEXT_PUBLIC_PORTAL_COLOR=
NEXT_PUBLIC_PORTAL_SUPPORT=
NEXT_PUBLIC_PORTAL_PRIVACY=
NEXT_PUBLIC_PORTAL_TERMS=
NEXT_PUBLIC_PORTAL_URL=
