# Local Decisionate API
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Clerk browser authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk server authentication. Use the secret from the same Clerk instance.
CLERK_SECRET_KEY=

# Fallback for bearer auth when the Clerk provider token bridge is unavailable.
# The normal browser flow supplies the Clerk bearer token automatically.
NEXT_PUBLIC_ENABLE_API_BEARER_AUTH=false
